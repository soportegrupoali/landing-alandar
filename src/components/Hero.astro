---
import { Image } from 'astro:assets';
import hero from '../assets/img/hero.webp';
import motifs from '../assets/img/iconos-circulares-blancos.png';
---

<section class="hero" id="inicio">
  <Image
    src={hero}
    alt="Vista nocturna de la casa club de Alandar Paseo Residencial rodeada de vegetación"
    class="hero-bg"
    widths={[640, 1024, 1600, 2200]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="wrap">
    <div class="content">
      <Image src={motifs} alt="" class="motifs" role="presentation" loading="eager" widths={[118]} sizes="118px" />
      <h1>La tierra que conecta tus raíces con la vida moderna.</h1>
      <p class="lede">
        Privada residencial con casa club, áreas verdes, parques y espacios pensados para vivir con
        tranquilidad, comunidad y bienestar.
      </p>
      <div class="hero-actions">
        <button class="btn btn-red" data-modal-open="brochure">Descargar brochure</button>
        <a class="btn btn-outline" href="#cotizador">Cotizar</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    color: #fff;
    isolation: isolate;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(15, 24, 12, 0.78), rgba(15, 24, 12, 0.32));
  }
  .content {
    max-width: 760px;
    padding-top: 76px;
  }
  .motifs {
    width: 118px;
    height: auto;
    margin-bottom: 20px;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 7.5vw, 6.2rem);
    letter-spacing: -0.045em;
  }
  .hero p {
    color: #fff;
    max-width: 620px;
    margin-top: 20px;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 26px;
  }

  @media (max-width: 900px) {
    .motifs {
      width: 94px;
    }
  }
</style>
