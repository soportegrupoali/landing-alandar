---
import { quote } from '../data/content';
---

<section class="section quote" id="cotizador" aria-labelledby="quote-heading">
  <div class="wrap">
    <div class="quote-copy" data-reveal>
      <p class="eyebrow">{quote.eyebrow}</p>
      <h2 class="title" id="quote-heading">{quote.title}</h2>
      <p class="lede">{quote.body}</p>
      {quote.ctaLabel && (
        <div class="quote-actions">
          <a class="btn btn-red" href="#contacto">{quote.ctaLabel}</a>
        </div>
      )}
    </div>

    {quote.iframeUrl && (
      <div class="quote-frame" data-reveal>
        <iframe
          src={quote.iframeUrl}
          title="Cotizador de lotes Alandar"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      </div>
    )}
  </div>
</section>

<style>
  .quote {
    background: #f0dfd0;
  }
  .quote-copy {
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }
  .quote-copy .title {
    max-width: none;
    margin-inline: auto;
  }
  .quote-copy .lede {
    margin-inline: auto;
  }
  .quote-actions {
    margin-top: 22px;
    display: flex;
    justify-content: center;
  }
  .quote-frame {
    margin-top: clamp(28px, 5vw, 44px);
    box-shadow: var(--shadow-lift);
    background: #fff;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .quote-frame iframe {
    display: block;
    width: 100%;
    height: clamp(640px, 120vw, 1000px);
    border: 0;
    background: #fff;
  }

  @media (max-width: 900px) {
    .quote-frame iframe {
      height: min(920px, 160vw);
    }
    .quote-actions .btn {
      width: 100%;
    }
  }
</style>
