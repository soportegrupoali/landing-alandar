---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo-alandar-blanco.png';
import { site, nav, footerContent } from '../data/content';

const year = new Date().getFullYear();
const navRows = Math.ceil(nav.length / 2);
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div>
      <Image src={logo} alt="Alandar Paseo Residencial" widths={[160]} sizes="160px" class="footer-logo" />
      <p class="footer-desc">{footerContent.description}</p>
    </div>

    <div class="footer-explore">
      <nav aria-label="Enlaces del sitio">
        <h2 class="footer-heading">Explorar</h2>
        <ul class="footer-list two-col" style={`--rows:${navRows}`}>
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      {footerContent.legalLinks?.length > 0 && (
        <nav aria-label="Legal" class="footer-legal-nav">
          <h2 class="footer-heading">Legal</h2>
          <ul class="footer-list">
            {footerContent.legalLinks.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </div>

    <div>
      <h2 class="footer-heading">Contacto</h2>
      <ul class="footer-list">
        <li><a href={`tel:${site.phoneDisplay.replace(/\s/g, '')}`}>{site.phoneDisplay}</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li>
          {site.address.street},<br />
          {site.address.locality}, {site.address.region}, C.P. {site.address.postalCode}
        </li>
      </ul>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>&copy; {year} {site.name}. Todos los derechos reservados.</p>
    <p class="footer-legal">{footerContent.legal}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-dark);
    color: #d6d0c6;
    padding-block: 64px 28px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 40px;
  }
  .footer-logo {
    height: 30px;
    width: auto;
    margin-bottom: 16px;
  }
  .footer-desc {
    color: #a8a297;
    max-width: 40ch;
  }
  .footer-heading {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff;
    margin-bottom: 16px;
  }
  .footer-explore {
    display: grid;
    gap: 32px;
  }
  .footer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
    font-size: 0.9rem;
  }
  .footer-list.two-col {
    grid-template-rows: repeat(var(--rows), auto);
    grid-auto-flow: column;
    column-gap: 24px;
  }
  .footer-list a {
    text-decoration: none;
    color: #d6d0c6;
    transition: color 0.2s ease;
  }
  .footer-list a:hover {
    color: #fff;
  }
  .footer-bottom {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.78rem;
    color: #8a8479;
  }
  .footer-bottom p {
    color: inherit;
    margin: 0;
  }
  .footer-legal {
    max-width: 48ch;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .footer-list.two-col {
      grid-template-rows: none;
      grid-auto-flow: row;
      grid-template-columns: 1fr 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 12px;
    }
    .footer-legal {
      max-width: none;
    }
  }

  @media (max-width: 480px) {
    .footer-list.two-col {
      grid-template-columns: 1fr;
    }
  }
</style>
