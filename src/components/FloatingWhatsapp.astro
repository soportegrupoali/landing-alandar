---
import { site } from '../data/content';

const message = encodeURIComponent('Hola, me interesa conocer más sobre Alandar Paseo Residencial.');
const href = `https://wa.me/${site.phoneWhatsapp}?text=${message}`;
---

<a class="float-chat" href={href} target="_blank" rel="noopener noreferrer" aria-label="Platica con un agente por WhatsApp (se abre en una pestaña nueva)">
  <span class="dot" aria-hidden="true"></span>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.9 9.9 0 0 0 4.76 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.1h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.13.82.84-3.05-.2-.31a8.18 8.18 0 0 1-1.26-4.4c0-4.53 3.69-8.22 8.25-8.22 2.2 0 4.27.86 5.83 2.42a8.17 8.17 0 0 1 2.41 5.82c0 4.53-3.69 8.25-8.24 8.25Zm4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.4-.12-.56.13-.17.25-.65.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.71-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.44.12-.15.16-.25.25-.42.08-.17.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.08s.89 2.41 1.02 2.58c.12.17 1.75 2.67 4.24 3.75.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.23-.17-.48-.29Z" />
  </svg>
  <span>Platica con un agente</span>
</a>

<style>
  .float-chat {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 60;
    background: var(--color-green);
    color: #fff;
    border-radius: 999px;
    padding: 14px 18px;
    box-shadow: var(--shadow-lift);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    transition: transform 0.2s ease;
  }
  .float-chat:hover,
  .float-chat:focus-visible {
    transform: translateY(-2px);
  }
  .float-chat:focus-visible {
    outline: 3px solid var(--color-peach);
    outline-offset: 2px;
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #9df06e;
    flex-shrink: 0;
  }

  @media (max-width: 560px) {
    .float-chat span:not(.dot) {
      display: none;
    }
    .float-chat {
      padding: 14px;
    }
  }
</style>
