{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landing-alandar-cms-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "vars": {
    // Públicos (no son secretos): identifican la Access Application, no dan acceso por sí solos.
    "CF_ACCESS_TEAM_DOMAIN": "PENDIENTE_DE_CONFIGURAR",
    "CF_ACCESS_AUD": "PENDIENTE_DE_CONFIGURAR",
    "ALLOWED_REPO": "soportegrupoali/landing-alandar"
  }
  // GITHUB_SHARED_TOKEN NO va aquí (este archivo se sube a git).
  // Se configura aparte y queda cifrado en Cloudflare:
  //   wrangler secret put GITHUB_SHARED_TOKEN
}
