---
import { Image } from 'astro:assets';
import locationMap from '../assets/img/location-transparent.png';
import { location, locationStats } from '../data/content';

const mapsHref =
  'https://www.google.com/maps/search/?api=1&query=Alandar%20Paseo%20Residencial%20San%20Antonio%20Hool%20M%C3%A9rida%20Yucat%C3%A1n';
---

<section class="section location" id="ubicacion" aria-labelledby="ubicacion-heading">
  <div class="wrap grid-2 location-grid">
    <div class="map-card" data-reveal>
      <Image
        src={locationMap}
        alt="Mapa de ubicación de Alandar en San Antonio Hool, al norte de Mérida, Yucatán"
        widths={[480, 720, 1024]}
        sizes="(min-width: 900px) 55vw, 92vw"
        loading="lazy"
      />
    </div>
    <div data-reveal>
      <p class="eyebrow">{location.eyebrow}</p>
      <h2 class="title" id="ubicacion-heading">{location.title}</h2>
      <p class="lede">{location.body}</p>
      <div class="cards">
        {locationStats.map((s) => (
          <div class="mini">
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
      <a class="btn btn-red" target="_blank" rel="noopener noreferrer" href={mapsHref}>Abrir en Google Maps</a>
    </div>
  </div>
</section>

<style>
  .location {
    background: #f0dfd0;
  }
  .location-grid {
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
  }
  .map-card {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: transparent;
  }
  .map-card :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 22px 0 26px;
  }
  .mini {
    background: #fff;
    border-radius: var(--radius-md);
    padding: 16px 18px;
    min-width: 0;
  }
  .mini strong {
    display: block;
    font-family: var(--font-display);
    color: var(--color-red);
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    line-height: 1.15;
    margin-bottom: 4px;
  }
  .mini span {
    font-size: 0.82rem;
    color: var(--color-ink-soft);
    line-height: 1.4;
    display: block;
  }

  @media (max-width: 900px) {
    .location-grid {
      grid-template-columns: 1fr;
    }
    .cards {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 560px) and (max-width: 900px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
