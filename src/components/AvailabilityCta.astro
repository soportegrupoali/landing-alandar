---
import { Image } from 'astro:assets';
import ctaImg from '../assets/img/cta.webp';
---

<section class="cta" aria-labelledby="cta-heading">
  <Image
    src={ctaImg}
    alt=""
    role="presentation"
    class="cta-bg"
    widths={[640, 1024, 1600]}
    sizes="100vw"
    loading="lazy"
  />
  <div class="cta-scrim" aria-hidden="true"></div>
  <div class="wrap grid-2 cta-content">
    <div data-reveal>
      <h2 class="title" id="cta-heading">Conoce disponibilidad y precio actualizado.</h2>
      <p class="lede">
        Un asesor puede compartirte lotes disponibles, ubicación dentro de la etapa y plan de pago
        vigente.
      </p>
    </div>
    <div data-reveal>
      <button class="btn btn-white" data-modal-open="info">Solicitar información</button>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    color: #fff;
    padding-block: 74px;
    isolation: isolate;
  }
  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cta-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(35, 68, 28, 0.9);
  }
  .cta-content p {
    color: #fff;
  }
</style>
