---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { gallery, gallerySection } from '../data/content';

const imgModules = import.meta.glob<{ default: ImageMetadata }>('../assets/img/galeria-*.webp', { eager: true });
const imgFor = (name: string) => imgModules[`../assets/img/${name}.webp`]?.default;
const VISIBLE = 5;
---

<section class="section gallery-section" id="galeria" aria-labelledby="galeria-heading">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">{gallerySection.eyebrow}</p>
      <h2 class="title" id="galeria-heading" data-reveal>{gallerySection.title.replace(/\n/g, ' ')}</h2>
      <p class="lede" data-reveal>{gallerySection.body}</p>
    </header>

    <div class="gal-grid" id="galGrid" data-reveal>
      {gallery.map((name, i) => {
        const img = imgFor(name);
        if (!img) return null;
        return (
          <button
            class="gal-item"
            class:list={[{ 'hidden-gal': i >= VISIBLE }]}
            data-lightbox-open
            data-index={i}
            aria-label={`Ver imagen ${i + 1} de la galería en grande`}
          >
            <Image
              src={img}
              alt={`Render de Alandar Paseo Residencial, imagen ${i + 1}`}
              widths={[320, 480, 640]}
              sizes="(min-width: 900px) 30vw, 90vw"
              loading={i < 2 ? 'eager' : 'lazy'}
            />
          </button>
        );
      })}
    </div>

    {gallery.length > VISIBLE && (
      <p class="gal-more">
        <button class="btn btn-red" id="moreGallery" aria-expanded="false" aria-controls="galGrid">
          Ver más imágenes
        </button>
      </p>
    )}
  </div>
</section>

<dialog id="lightbox" class="lightbox" aria-label="Galería de imágenes de Alandar">
  <button class="lightbox-close" id="lightboxClose" aria-label="Cerrar galería">×</button>
  <button class="lightbox-nav prev" id="lightboxPrev" aria-label="Imagen anterior">‹</button>
  <img id="lightboxImg" alt="" />
  <button class="lightbox-nav next" id="lightboxNext" aria-label="Imagen siguiente">›</button>
</dialog>

<style>
  .gallery-section {
    background: #fff;
    color: var(--color-dark);
  }
  .gallery-section p {
    color: var(--color-ink-soft);
  }
  .section-head {
    max-width: 46rem;
  }
  .gal-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr 0.9fr;
    grid-auto-rows: minmax(180px, 22vw);
    gap: 14px;
    margin-top: 30px;
  }
  .gal-item {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    cursor: pointer;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    background: #e8e0d6;
  }
  .gal-item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s ease;
  }
  .gal-item:hover :global(img),
  .gal-item:focus-visible :global(img) {
    transform: scale(1.04);
  }
  .gal-item:focus-visible {
    outline: 3px solid var(--color-peach);
    outline-offset: 3px;
  }
  .gal-item:first-child {
    grid-row: span 2;
  }
  .hidden-gal {
    display: none;
  }
  .gal-grid.more-open .hidden-gal {
    display: block;
  }
  .gal-more {
    margin-top: 24px;
  }

  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
  }
  .lightbox::backdrop {
    background: rgba(5, 5, 4, 0.92);
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    width: 100vw;
    height: 100vh;
  }
  .lightbox img {
    max-width: min(1100px, 92vw);
    max-height: 86vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: var(--shadow-lift);
  }
  .lightbox-close,
  .lightbox-nav {
    position: fixed;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    border-radius: 999px;
    cursor: pointer;
  }
  .lightbox-close {
    top: 20px;
    right: 20px;
    width: 44px;
    height: 44px;
    font-size: 1.4rem;
  }
  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    font-size: 1.6rem;
  }
  .lightbox-nav.prev {
    left: 20px;
  }
  .lightbox-nav.next {
    right: 20px;
  }

  @media (max-width: 900px) {
    .gal-grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: minmax(140px, 28vw);
    }
    .gal-item:first-child {
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: 16 / 9;
      height: auto;
    }
  }

  @media (max-width: 560px) {
    .gal-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
      gap: 12px;
    }
    .gal-item {
      aspect-ratio: 16 / 9;
      height: auto;
    }
    .gal-item:first-child {
      grid-column: auto;
    }
    .lightbox-nav {
      width: 44px;
      height: 44px;
    }
    .lightbox-nav.prev {
      left: 10px;
    }
    .lightbox-nav.next {
      right: 10px;
    }
  }
</style>

<script>
  const grid = document.getElementById('galGrid');
  const moreBtn = document.getElementById('moreGallery');
  moreBtn?.addEventListener('click', () => {
    const open = grid?.classList.toggle('more-open');
    moreBtn.setAttribute('aria-expanded', String(Boolean(open)));
    moreBtn.textContent = open ? 'Ver menos imágenes' : 'Ver más imágenes';
  });

  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]'));
  const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement | null;
  let current = 0;

  const show = (i: number) => {
    current = (i + items.length) % items.length;
    const img = items[current].querySelector('img');
    if (img && lightboxImg) {
      lightboxImg.src = img.currentSrc || img.src;
      lightboxImg.alt = img.alt;
    }
  };

  items.forEach((item, i) => {
    item.addEventListener('click', () => {
      show(i);
      lightbox?.showModal();
    });
  });

  document.getElementById('lightboxClose')?.addEventListener('click', () => lightbox?.close());
  document.getElementById('lightboxPrev')?.addEventListener('click', () => show(current - 1));
  document.getElementById('lightboxNext')?.addEventListener('click', () => show(current + 1));
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) lightbox.close();
  });
  lightbox?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(current + 1);
    if (e.key === 'ArrowLeft') show(current - 1);
  });
</script>
