---
import { Image } from 'astro:assets';
import projectImg from '../assets/img/project.webp';
import { project, stats } from '../data/content';
---

<section class="section" id="proyecto" aria-labelledby="proyecto-heading">
  <div class="wrap grid-2">
    <div data-reveal>
      <p class="eyebrow">{project.eyebrow}</p>
      <h2 class="title" id="proyecto-heading">{project.title}</h2>
      <p class="lede">{project.body}</p>
      {project.closing && <p class="closing">{project.closing}</p>}
      <dl class="stats">
        {stats.map((s) => (
          <div class="stat">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="card-img" data-reveal>
      <Image
        src={projectImg}
        alt="Vista aérea del desarrollo Alandar mostrando lotes, parques y vialidades"
        widths={[480, 720, 960]}
        sizes="(min-width: 900px) 45vw, 92vw"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .section {
    background: var(--color-cream);
  }
  .closing {
    margin-top: 14px;
    font-weight: 600;
    color: var(--color-dark);
    max-width: 48ch;
    line-height: 1.55;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 28px 0 0;
  }
  .stat {
    background: #fff;
    border-radius: var(--radius-md);
    padding: clamp(16px, 2.5vw, 22px);
    box-shadow: var(--shadow-soft);
    min-width: 0;
  }
  .stat dt {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #8a837b;
    margin-bottom: 9px;
    line-height: 1.35;
  }
  .stat dd {
    margin: 0;
    font-family: var(--font-display);
    color: var(--color-red);
    font-size: clamp(1.45rem, 2.8vw, 2.2rem);
    line-height: 1.1;
    word-break: break-word;
  }

  @media (max-width: 900px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 520px) and (max-width: 900px) {
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
