---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/content';
---

<Layout title={`Aviso de privacidad | ${site.name}`} description="Aviso de privacidad de Alandar Paseo Residencial.">
  <section class="section legal-page">
    <div class="wrap">
      <h1 class="title">Aviso de privacidad</h1>
      <p class="lede">
        Este aviso de privacidad está en preparación. Para cualquier duda sobre el tratamiento de tus
        datos personales, escríbenos a <a href={`mailto:${site.email}`}>{site.email}</a> o llámanos al{' '}
        <a href={`tel:${site.phoneDisplay.replace(/\s/g, '')}`}>{site.phoneDisplay}</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .legal-page {
    padding-top: 140px;
    min-height: 50vh;
  }
  .legal-page .lede {
    margin-top: 18px;
    max-width: 60ch;
  }
</style>
