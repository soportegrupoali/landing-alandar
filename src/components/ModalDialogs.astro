---
import { site } from '../data/content';
---

<dialog id="brochure" class="modal">
  <button class="x" data-close aria-label="Cerrar">×</button>
  <h3 class="title modal-title">Descarga el brochure</h3>
  <p>Déjanos tus datos para habilitar la descarga.</p>
  <form id="brochureForm" data-whatsapp={site.phoneWhatsapp} data-pdf="/media/brochure-alandar-2026.pdf">
    <div class="field">
      <label class="field-label" for="b-name">Nombre</label>
      <input id="b-name" name="name" required placeholder="Tu nombre" autocomplete="name" />
    </div>
    <div class="field">
      <label class="field-label" for="b-phone">Teléfono</label>
      <input id="b-phone" name="phone" required placeholder="999 000 0000" autocomplete="tel" inputmode="tel" />
    </div>
    <div class="field">
      <label class="field-label" for="b-email">Correo</label>
      <input id="b-email" name="email" required type="email" placeholder="correo@ejemplo.com" autocomplete="email" />
    </div>
    <button class="btn btn-red" style="width:100%" type="submit">Descargar brochure</button>
  </form>
</dialog>

<dialog id="info" class="modal">
  <button class="x" data-close aria-label="Cerrar">×</button>
  <h3 class="title modal-title">Solicita información</h3>
  <form id="infoForm" data-whatsapp={site.phoneWhatsapp}>
    <div class="field">
      <label class="field-label" for="i-name">Nombre y apellido</label>
      <input id="i-name" name="name" required placeholder="Tu nombre" autocomplete="name" />
    </div>
    <div class="field">
      <label class="field-label" for="i-phone">Teléfono</label>
      <input id="i-phone" name="phone" required placeholder="999 000 0000" autocomplete="tel" inputmode="tel" />
    </div>
    <div class="field">
      <label class="field-label" for="i-email">Correo</label>
      <input id="i-email" name="email" required type="email" placeholder="correo@ejemplo.com" autocomplete="email" />
    </div>
    <div class="field">
      <label class="field-label" for="i-message">Mensaje</label>
      <textarea id="i-message" name="message" placeholder="Cuéntanos cómo podemos ayudarte"></textarea>
    </div>
    <button class="btn btn-red" style="width:100%" type="submit">Enviar mensaje</button>
  </form>
</dialog>

<style>
  .modal {
    position: relative;
    border: 0;
    border-radius: 24px;
    padding: 28px;
    width: min(520px, 94vw);
    box-shadow: var(--shadow-lift);
    margin: auto;
    background: #fff;
  }
  .modal::backdrop {
    background: rgba(0, 0, 0, 0.58);
  }
  .modal-title {
    font-size: clamp(1.6rem, 3vw, 2rem);
    margin-bottom: 6px;
    max-width: none;
    padding-right: 36px;
  }
  .modal form {
    display: grid;
    gap: 4px;
    margin-top: 16px;
  }
  .modal p {
    color: var(--color-ink-soft);
  }
  .x {
    position: absolute;
    top: 14px;
    right: 14px;
    border: 0;
    background: #f4eee7;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    cursor: pointer;
    font-size: 1.1rem;
    display: grid;
    place-items: center;
    line-height: 1;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-modal-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.modalOpen;
      const dialog = id ? document.getElementById(id) : null;
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('dialog.modal').forEach((dialog) => {
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });

  const brochureForm = document.getElementById('brochureForm') as HTMLFormElement | null;
  brochureForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const pdf = brochureForm.dataset.pdf;
    if (pdf) window.open(pdf, '_blank', 'noopener,noreferrer');
    (brochureForm.closest('dialog') as HTMLDialogElement | null)?.close();
    brochureForm.reset();
  });

  const infoForm = document.getElementById('infoForm') as HTMLFormElement | null;
  infoForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(infoForm);
    const phone = infoForm.dataset.whatsapp;
    const lines = [
      'Hola, quiero solicitar información de Alandar Paseo Residencial.',
      `Nombre: ${data.get('name')}`,
      `Teléfono: ${data.get('phone')}`,
      `Correo: ${data.get('email')}`,
      `Mensaje: ${data.get('message') || '(sin mensaje)'}`,
    ];
    if (phone) {
      window.open(`https://wa.me/${phone}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener,noreferrer');
    }
    (infoForm.closest('dialog') as HTMLDialogElement | null)?.close();
    infoForm.reset();
  });
</script>
