---
import { financing, financingSection } from '../data/content';
---

<section class="section finance" id="financiamiento" aria-labelledby="finance-heading">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">{financingSection.eyebrow}</p>
      <h2 class="title" id="finance-heading" data-reveal>{financingSection.title.replace(/\n/g, ' ')}</h2>
      <p class="lede" data-reveal>{financingSection.body}</p>
    </header>

    <div class="finance-cards" data-reveal>
      {financing.map((f) => (
        <div class="finance-card">
          <span>{f.label}</span>
          <strong>{f.value}</strong>
          {f.note && <small>{f.note}</small>}
        </div>
      ))}
    </div>

    {financingSection.ctaLabel && (
      <a class="btn btn-red finance-cta" href="#contacto" data-reveal>{financingSection.ctaLabel}</a>
    )}
  </div>
</section>

<style>
  .finance {
    background: #fff;
  }
  .section-head {
    max-width: 46rem;
  }
  .finance-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 30px;
    max-width: 720px;
  }
  .finance-card {
    background: var(--color-bg);
    border-radius: var(--radius-md);
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid #eee;
    min-width: 0;
  }
  .finance-card span {
    display: block;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #81796f;
    margin-bottom: 8px;
  }
  .finance-card strong {
    display: block;
    color: var(--color-red);
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.25rem);
    font-weight: 400;
    line-height: 1.1;
    word-break: break-word;
  }
  .finance-card small {
    display: block;
    color: var(--color-ink-soft);
    line-height: 1.45;
    margin-top: 8px;
    font-size: 0.8rem;
  }

  .finance-cta {
    margin-top: 28px;
  }

  @media (max-width: 600px) {
    .finance-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
